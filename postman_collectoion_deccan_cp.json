{
  "info": {
    "_postman_id": "7b8f93f0-c6cb-4e89-b4cb-3c8deccan001",
    "name": "Deccan Control Plane",
    "description": "API collection for Deccan Control Plane",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8088/api"
    },
    {
      "key": "jwt",
      "value": ""
    },
    {
      "key": "organizationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\":\"admin@deccan.dev\",\n    \"password\":\"change-me\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('jwt', json.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Who Am I",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Organization",
      "item": [
        {
          "name": "Create Organization",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\":\"Acme Technologies\",\n    \"slug\":\"acme\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/identity/organizations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "identity",
                "organizations"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('organizationId', json.data.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Roles",
      "item": [
        {
          "name": "Create Role",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"organizationId\":\"{{organizationId}}\",\n    \"name\":\"DEVELOPER\",\n    \"description\":\"Developer Role\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/identity/roles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "identity",
                "roles"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"organizationId\":\"{{organizationId}}\",\n    \"firstName\":\"John\",\n    \"lastName\":\"Doe\",\n    \"email\":\"john@acme.com\",\n    \"password\":\"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/identity/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "identity",
                "users"
              ]
            }
          }
        },
        {
          "name": "Get Organization Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/identity/organizations/{{organizationId}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "identity",
                "organizations",
                "{{organizationId}}",
                "users"
              ]
            }
          }
        }
      ]
    }
  ]
}